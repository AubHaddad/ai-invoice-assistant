POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_invoice_assistant
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_invoice_assistant

AUTH_SECRET=
# Google OAuth — authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# LLM providers — Anthropic is primary, OpenAI is fallback. Change without a rebuild.
AI_PRIMARY_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=openai
AI_ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5
AI_ANTHROPIC_FAST_MODEL=claude-haiku-4-5
AI_ANTHROPIC_SMART_MODEL=claude-sonnet-4-6
AI_OPENAI_CHEAP_MODEL=gpt-5.4-nano
AI_OPENAI_FAST_MODEL=gpt-5.4-mini
AI_OPENAI_SMART_MODEL=gpt-5.4
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Langfuse tracing — keys from project Settings > API Keys
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Google Cloud Storage — browser uploads via V4 signed PUT URLs.
# Bucket CORS must allow PUT from this origin with Content-Type:
# origin: http://localhost:3000 (and the production origin)
# method: PUT, OPTIONS
# responseHeader: Content-Type, Content-Length, x-goog-resumable
GCS_BUCKET=
GCS_PROJECT_ID=
# Option A: path to a service-account JSON key
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: inline credentials (newlines as \n)
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=

# Upstash Redis — sliding-window chat rate limit + daily token budget.
# Create a database at https://console.upstash.com/redis and paste REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional overrides (defaults: 20 requests/minute, 200000 tokens/day)
CHAT_REQUESTS_PER_MINUTE=20
CHAT_DAILY_TOKEN_BUDGET=200000
